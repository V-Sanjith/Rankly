# ============================================
# RANKLY — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================

# ---- Database ----
DATABASE_URL="postgresql://rankly:rankly_dev_password@localhost:5432/rankly?schema=public"
# Direct URL for Prisma migrations (use if behind a connection pooler)
DIRECT_URL="postgresql://rankly:rankly_dev_password@localhost:5432/rankly?schema=public"

# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Authentication ----
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d

# ---- Razorpay ----
# Get test keys from https://dashboard.razorpay.com (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- AI Features (Future) ----
# AI_API_KEY=
# AI_API_URL=

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
